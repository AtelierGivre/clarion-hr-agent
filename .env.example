# Agent runtime: gemini (default), anthropic, or openai
LLM_PROVIDER=gemini

# Gemini (also used for embeddings)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Claude (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Leave blank for the local Postgres started by scripts/dev.py
DATABASE_URL=
